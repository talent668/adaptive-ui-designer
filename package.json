{
  "name": "adaptive-ui-designer",
  "version": "0.3.0",
  "private": true,
  "description": "Reproducible validation for the portable Adaptive UI Designer skill",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node scripts/run-tests.cjs",
