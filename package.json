    "cli:prepare": "node scripts/prepare-cli.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "linkedom": "0.18.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4",
    "vue": "3.5.44"
  }
}
